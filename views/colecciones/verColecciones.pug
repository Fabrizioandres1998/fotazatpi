extends ../layout

block content
    .container.mt-4
        .d-flex.justify-content-between.align-items-center.mb-4
            div
                a.btn.btn-secondary.mb-3(href="/colecciones") ← Volver
                h1= coleccion.nombre
                p.text-muted #{coleccion.publicaciones.length} publicaciones
            form(action=`/colecciones/eliminar/${coleccion.id}`, method="POST", onsubmit="return confirm('¿Eliminar esta colección?')")
                button.btn.btn-outline-danger(type="submit") Eliminar colección

        if coleccion.publicaciones && coleccion.publicaciones.length > 0
            .row
                each pub in coleccion.publicaciones
                    .col-md-4.mb-4
                        .card.h-100
                            if pub.imagenes && pub.imagenes.length
                                img.card-img-top(src=pub.imagenes[0].url style="height: 200px; object-fit: cover;")
                            else
                                .card-img-top.bg-secondary.d-flex.align-items-center.justify-content-center(style="height: 200px;")
                                    span.text-white Sin imagen
                            .card-body
                                h5.card-title= pub.titulo
                                p.card-text.text-muted= pub.descripcion.substring(0, 100)
                                .d-flex.gap-2
                                    a.btn.btn-sm.btn-outline-primary(href=`/publicaciones/${pub.id}`) Ver
                                    form(action=`/colecciones/${coleccion.id}/quitar/${pub.id}`, method="POST", onsubmit="return confirm('¿Quitar esta publicación de la colección?')")
                                        button.btn.btn-sm.btn-outline-danger(type="submit") Quitar
        else
            .alert.alert-info
                p Esta colección no tiene publicaciones aún.
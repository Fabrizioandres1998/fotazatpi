extends ../layout

block content
    .container.mt-4
        .row
            .col-md-6.offset-md-3
                .card
                    .card-header
                        h3 Nueva colección
                    .card-body
                        form(action="/colecciones/crear", method="POST")
                            .mb-3
                                label.form-label(for="nombre") Nombre de la colección *
                                input.form-control(type="text", name="nombre", id="nombre", required, placeholder="Ej: Favoritos, Para comprar, Inspiración...")
                            .d-flex.gap-2
                                button.btn.btn-primary(type="submit") Crear
                                a.btn.btn-secondary(href="/colecciones") Cancelar
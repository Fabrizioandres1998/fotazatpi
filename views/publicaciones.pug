extends layout

block content
    .container.mt-4
        h1.mb-4 Publicaciones

        if busqueda
            .alert.alert-info
                | Resultados para: "#{busqueda}"
                a.ms-3(href="/publicaciones") Limpiar búsqueda

        if filtro
            .alert.alert-info
                | Publicaciones con la etiqueta: #{filtro}
                a.ms-3(href="/publicaciones") Ver todas

        // Mostrar usuarios encontrados
        if usuarios && usuarios.length > 0
            .card.mb-4
                .card-header
                    h5.mb-0 Usuarios encontrados
                .card-body
                    .row
                        each usuario in usuarios
                            .col-md-4.mb-2
                                a(href=`/perfil/${usuario.username}`) 
                                    i.bi.bi-person-circle
                                    |  #{usuario.username}

        // Mostrar publicaciones
        if publicaciones && publicaciones.length > 0
            .row
                each pub in publicaciones
                    .col-md-6.col-lg-4.mb-4
                        .card.h-100.shadow-sm
                            if pub.imagenes && pub.imagenes.length
                                img.card-img-top(src=pub.imagenes[0].url style="height: 200px; object-fit: cover;")
                            else
                                .card-img-top.bg-secondary.d-flex.align-items-center.justify-content-center(style="height: 200px;")
                                    span.text-white Sin imagen

                            .card-body
                                h5.card-title= pub.titulo
                                p.card-text.text-muted= pub.descripcion.substring(0, 100)

                                if pub.etiquetas && pub.etiquetas.length
                                    .mb-2
                                        each etiq in pub.etiquetas
                                            a.badge.bg-primary.me-1.text-decoration-none(href=`/publicaciones?etiqueta=${etiq.nombre}`) #{etiq.nombre}

                                // Mostrar promedio y cantidad de votos con estrellitas
                                if pub.valoraciones && pub.valoraciones.length > 0
                                    .mt-2
                                        - const suma = pub.valoraciones.reduce((acc, v) => acc + v.puntaje, 0);
                                        - const promedio = suma / pub.valoraciones.length;
                                        - const estrellasLlenas = Math.floor(promedio);
                                        - const tieneMedia = (promedio % 1) >= 0.5;
                                        .d-flex.align-items-center.gap-2
                                            .text-warning
                                                - for (let i = 1; i <= 5; i++)
                                                    if i <= estrellasLlenas
                                                        i.bi.bi-star-fill
                                                    else if i === estrellasLlenas + 1 && tieneMedia
                                                        i.bi.bi-star-half
                                                    else
                                                        i.bi.bi-star
                                            span
                                                strong #{promedio.toFixed(1)}
                                                |  (#{pub.valoraciones.length} voto#{pub.valoraciones.length !== 1 ? 's' : ''})
                                else
                                    .mt-2.text-muted
                                        i.bi.bi-star
                                        |  Sin valoraciones

                                if pub.Usuario
                                    small.text-muted
                                        a(href=`/perfil/${pub.Usuario.username}`)
                                            i.bi.bi-person
                                            |  #{pub.Usuario.username}

                            .card-footer.bg-transparent
                                a.btn.btn-sm.btn-outline-primary(href=`/publicaciones/${pub.id}`) Ver más
        else if !usuarios || usuarios.length === 0
            .alert.alert-info
                if busqueda
                    p No se encontraron publicaciones ni usuarios que coincidan con "#{busqueda}"
                else if filtro
                    p No hay publicaciones con la etiqueta "#{filtro}"
                else
                    p No hay publicaciones disponibles
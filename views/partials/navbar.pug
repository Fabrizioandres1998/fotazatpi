nav.navbar.navbar-expand-lg.navbar-dark.bg-dark
    .container
        a.navbar-brand(href="/")
            | Fotaza
            i.bi.bi-camera-fill.ms-2
        button.navbar-toggler(type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav")
            span.navbar-toggler-icon
        .collapse.navbar-collapse(id="navbarNav")
            ul.navbar-nav.ms-auto
                if session && session.id_usuario
                    li.nav-item
                        span.nav-link.text-success
                            i.bi.bi-person-circle
                            |  #{session.username}
                    li.nav-item
                        a.nav-link(href="/publicaciones") Publicaciones
                    li.nav-item
                        a.nav-link(href="/perfil") Mi Perfil
                    if session.rol === 'moderador'
                        li.nav-item
                            a.nav-link(href="/moderador/reportes" class="moderador-link")
                                i.bi.bi-shield-shaded
                                |  Panel Moderador
                    li.nav-item
                        form(action="/logout" method="POST")
                            button.btn.btn-link.nav-link(type="submit") Cerrar sesión
                else
                    li.nav-item
                        a.nav-link(href="/login") Iniciar sesión
                    li.nav-item
                        a.nav-link(href="/registro") Registrarse
doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Iniciar Sesión
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet")
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css")

  body.bg-light
    .container.mt-5
      .row.justify-content-center
        .col-md-6.col-lg-4
          .card.shadow
            .card-header.bg-primary.text-white.text-center
              h3.mb-0 Iniciar Sesión

            .card-body
              // CONTENEDOR PARA MENSAJES DE ERROR
              div(id="errorContainer")
              
              form(id="formLogin")
                .mb-3
                  label.form-label(for="email") Correo electronico
                  input.form-control(type="email" id="email" name="email" placeholder="correo@ejemplo.com" required)
                
                .mb-3
                  label.form-label(for="password") Contraseña
                  input.form-control(type="password" id="password" name="password_hash" placeholder="Tu contraseña" required)
                
                button.btn.btn-primary.w-100(type="submit") Iniciar Sesión
                
                hr
                
                .text-center
                  p.mb-0 ¿No tenes cuenta? 
                    a(href="/registro") Registrate aca
                  p.mb-0 Ingresar como 
                    a(href="/") visitante

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js")
    script.
      const formLogin = document.getElementById('formLogin');
      const errorContainer = document.getElementById('errorContainer');
      
      formLogin.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const email = document.getElementById('email').value;
        const password = document.getElementById('password').value;
        
        // Limpiar errores anteriores
        errorContainer.innerHTML = '';
        
        // Deshabilitar boton mientras se procesa
        const btnSubmit = this.querySelector('button[type="submit"]');
        const textoOriginal = btnSubmit.innerHTML;
        btnSubmit.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Iniciando sesión...';
        btnSubmit.disabled = true;
        
        try {
          const response = await fetch('/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: email, password_hash: password })
          });
          
          const data = await response.json();
          
          if (data.success) {
            // Mostrar mensaje de exito
            const successDiv = document.createElement('div');
            successDiv.className = 'alert alert-success';
            successDiv.innerHTML = '<i class="bi bi-check-circle"></i> Inicio de sesión exitoso. Redirigiendo...';
            errorContainer.appendChild(successDiv);
            
            // Redirigir despues de 1 segundo
            setTimeout(() => {
              window.location.href = data.redirect || '/';
            }, 1000);
          } else {
            // Mostrar mensaje de error
            const errorDiv = document.createElement('div');
            errorDiv.className = 'alert alert-danger';
            errorDiv.innerHTML = '<i class="bi bi-exclamation-triangle"></i> ' + (data.error || 'Error al iniciar sesión');
            errorContainer.appendChild(errorDiv);
            
            // Limpiar campo contraseña
            document.getElementById('password').value = '';
          }
        } catch (error) {
          console.error('Error:', error);
          const errorDiv = document.createElement('div');
          errorDiv.className = 'alert alert-danger';
          errorDiv.innerHTML = '<i class="bi bi-exclamation-triangle"></i> Error de conexión. Intenta nuevamente.';
          errorContainer.appendChild(errorDiv);
        } finally {
          btnSubmit.innerHTML = textoOriginal;
          btnSubmit.disabled = false;
        }
      });
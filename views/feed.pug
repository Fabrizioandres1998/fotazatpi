extends layout

block content
    .container.mt-4
        h1.mb-4 Publicaciones de usuarios a los que sigo
        
        if mensaje
            .alert.alert-info
                p= mensaje
                a.btn.btn-primary.mt-2(href="/publicaciones") Explorar publicaciones
        
        if publicaciones && publicaciones.length > 0
            .row
                each pub in publicaciones
                    .col-md-6.col-lg-4.mb-4
                        .card.h-100.shadow-sm
                            if pub.imagenes && pub.imagenes.length
                                img.card-img-top(src=pub.imagenes[0].url style="height: 200px; object-fit: cover;")
                            else
                                .card-img-top.bg-secondary.d-flex.align-items-center.justify-content-center(style="height: 200px;")
                                    span.text-white Sin imagen
                            
                            .card-body
                                h5.card-title= pub.titulo
                                p.card-text.text-muted= pub.descripcion.substring(0, 100)
                                
                                if pub.etiquetas && pub.etiquetas.length
                                    .mb-2
                                        each etiq in pub.etiquetas
                                            a.badge.bg-primary.me-1.text-decoration-none(href=`/publicaciones?etiqueta=${etiq.nombre}`) #{etiq.nombre}
                                
                                if pub.Usuario
                                    small.text-muted
                                        a(href=`/perfil/${pub.Usuario.username}`)
                                            i.bi.bi-person
                                            |  #{pub.Usuario.username}
                            
                            .card-footer.bg-transparent
                                a.btn.btn-sm.btn-outline-primary(href=`/publicaciones/${pub.id}`) Ver más
        else if !mensaje
            .alert.alert-warning
                p No hay publicaciones de los usuarios que sigues.
                a.btn.btn-primary.mt-2(href="/publicaciones") Explorar publicaciones
doctype html
html
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        title Fotaza

        link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet")
        link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css")

    body.bg-light
        include ./partials/navbar.pug
        include ./partials/logout.pug

        main
            block content

        // MODAL DE NOTIFICACIONES
        .modal.fade(id="modalNotificaciones" tabindex="-1")
            .modal-dialog.modal-lg
                .modal-content
                    .modal-header
                        h5.modal-title Notificaciones
                        button.btn-close(type="button" data-bs-dismiss="modal")
                    .modal-body(id="contenedorNotificaciones")
                        .text-center
                            .spinner-border.text-primary
                            p.mt-2 Cargando...
                    .modal-footer
                        button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cerrar

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js")
    script.
        // Cargar notificaciones al abrir el modal
        const modalNotificaciones = document.getElementById('modalNotificaciones');
        if (modalNotificaciones) {
            modalNotificaciones.addEventListener('show.bs.modal', async function() {
                const contenedor = document.getElementById('contenedorNotificaciones');
                contenedor.innerHTML = '<div class="text-center"><div class="spinner-border text-primary"></div><p class="mt-2">Cargando...</p></div>';

                try {
                    const response = await fetch('/notificaciones/listar');
                    const notificaciones = await response.json();

                    if (notificaciones.length === 0) {
                        contenedor.innerHTML = '<div class="text-center text-muted">No tienes notificaciones</div>';
                        return;
                    }

                    let html = '<div class="list-group">';
                    notificaciones.forEach(notif => {
                        const clase = notif.leida ? '' : 'list-group-item-warning';
                        const esInteres = notif.mensaje && notif.mensaje.includes('quiere adquirir');
                        const esMensaje = notif.mensaje && notif.mensaje.includes('te envió un mensaje');
                      const botonRespuesta = esInteres && notif.origen ? `<a href="/mensajes/ver/${notif.origen.id}" class="btn btn-sm btn-success ms-2">Responder</a>` : '';
                        const botonVerMensaje = esMensaje && notif.origen ? `<a href="/mensajes/ver/${notif.origen.id}" class="btn btn-sm btn-info ms-2">Ver mensaje</a>` : '';

                        html += `
                            <div class="list-group-item ${clase}" data-id="${notif.id}">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        ${notif.origen ? `<a href="/perfil/${notif.origen.username}" class="text-decoration-none fw-bold">${notif.origen.username}</a>` : '<strong>Sistema</strong>'}
                                        <span> ${notif.mensaje || ''}</span>
                                        <br>
                                        <small class="text-muted">${new Date(notif.createdAt).toLocaleString()}</small>
                                    </div>
                                    <div>
                                        ${botonRespuesta}
                                        ${botonVerMensaje}
                                        ${!notif.leida ? `<button class="btn btn-sm btn-outline-secondary marcar-leida" data-id="${notif.id}">Leído</button>` : ''}
                                    </div>
                                </div>
                            </div>
                        `;
                    });
                    html += '</div>';
                    contenedor.innerHTML = html;

                    // Marcar como leídas
                    document.querySelectorAll('.marcar-leida').forEach(btn => {
                        btn.addEventListener('click', async function(e) {
                            e.stopPropagation();
                            const id = this.dataset.id;
                            await fetch(`/notificaciones/marcar/${id}`, { method: 'POST' });
                            const item = this.closest('.list-group-item');
                            item.classList.remove('list-group-item-warning');
                            this.remove();

                            // Actualizar badge
                            const badge = document.querySelector('.bi-bell + .badge');
                            if (badge) {
                                const newCount = parseInt(badge.textContent) - 1;
                                if (newCount > 0) {
                                    badge.textContent = newCount;
                                } else {
                                    badge.remove();
                                }
                            }
                        });
                    });
                } catch (error) {
                    console.error('Error:', error);
                    contenedor.innerHTML = '<div class="text-center text-danger">Error al cargar notificaciones</div>';
                }
            });
        }